<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Rotación 8</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&display=swap">
<style>
/* Layout: sticky header with a step rail, one centered lesson card per step, sticky Back/Next bar at the bottom. */
:root{
  --bg:#eef2f8; --surface:#ffffff; --sunk:#f5f7fb; --ink:#152036; --muted:#566179; --line:#d6ddea;
  --accent:#1d4ea0; --accent-ink:#ffffff; --accent-soft:#e3ebfa;
  --sun:#f3a712; --sun-soft:#fff3d6; --sun-ink:#7a4a00;
  --ok:#17744a; --ok-bg:#e2f5ea; --bad:#b3261e; --bad-bg:#fde8e6; --rev:#8a5a00; --rev-bg:#fff1d0;
  --display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0e1320; --surface:#172034; --sunk:#121a2b; --ink:#e7ecf5; --muted:#9ca7bd; --line:#2a3550;
  --accent:#86a9ff; --accent-ink:#0e1320; --accent-soft:#1e2b4a;
  --sun:#f6b93b; --sun-soft:#3a2c0e; --sun-ink:#ffd88a;
  --ok:#62d29b; --ok-bg:#12301f; --bad:#ff8d84; --bad-bg:#3b1815; --rev:#ffcf70; --rev-bg:#382a0c; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e1320; --surface:#172034; --sunk:#121a2b; --ink:#e7ecf5; --muted:#9ca7bd; --line:#2a3550;
  --accent:#86a9ff; --accent-ink:#0e1320; --accent-soft:#1e2b4a;
  --sun:#f6b93b; --sun-soft:#3a2c0e; --sun-ink:#ffd88a;
  --ok:#62d29b; --ok-bg:#12301f; --bad:#ff8d84; --bad-bg:#3b1815; --rev:#ffcf70; --rev-bg:#382a0c; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
.top-in{max-width:820px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px 6px}
.brand{display:flex;align-items:baseline;gap:10px;min-width:0}
.brand-k{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}
.brand-t{font-family:var(--display);font-weight:800;font-size:22px;letter-spacing:-.01em}
.who{font-size:14px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.who b{color:var(--ink)}
.rail-wrap{max-width:820px;margin:0 auto;overflow-x:auto;scrollbar-width:thin}
.rail{display:flex;gap:6px;padding-block:6px 10px;width:max-content}
.chip{font:inherit;font-size:13px;border:1px solid var(--line);background:var(--sunk);color:var(--muted);border-radius:999px;padding:4px 10px;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px}
.chip .n{font-variant-numeric:tabular-nums;font-weight:700}
.chip[disabled]{cursor:not-allowed;opacity:.55}
.chip.done{background:var(--ok-bg);color:var(--ok);border-color:transparent}
.chip.cur{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
main{padding-block:22px 110px}
.step{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
.eyebrow{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:700;display:flex;gap:10px;flex-wrap:wrap}
.eyebrow .time{color:var(--muted);letter-spacing:.04em;text-transform:none;font-weight:400}
h1,h2{font-family:var(--display);font-weight:800;letter-spacing:-.015em;line-height:1.15;margin:0;text-wrap:balance}
h1{font-size:clamp(30px,5vw,42px)}
h2{font-size:clamp(26px,4vw,34px)}
h3{font-family:var(--display);font-weight:600;font-size:20px;margin:0}
p{margin:0}
.lead{font-size:18px;color:var(--muted);max-width:62ch}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:14px;min-width:0}
.note{background:var(--sun-soft);color:var(--sun-ink);border-radius:12px;padding:12px 16px}
.rule{background:var(--accent-soft);border-radius:12px;padding:14px 18px;display:flex;flex-direction:column;gap:8px}
.rule strong{color:var(--accent)}
.es{font-style:italic}
ul.clean,ol.clean{margin:0;padding-left:1.2em;display:flex;flex-direction:column;gap:6px}
.qlist{display:flex;flex-direction:column;gap:16px;margin:0;padding:0;list-style:none;counter-reset:q}
.qlist>li{counter-increment:q;display:grid;grid-template-columns:2em 1fr;gap:4px 8px;align-items:baseline}
.qlist>li::before{content:counter(q) ".";font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums}
.qlist>li>*{grid-column:2;min-width:0}
.sub{font-size:14px;color:var(--muted)}
.prompt-en{font-weight:700}
input.in,select.in,textarea{font:inherit;color:var(--ink);background:var(--sunk);border:2px solid var(--line);border-radius:8px;padding:4px 8px;max-width:100%}
input.in{min-width:5ch}
input.in.wide{width:100%!important;display:block;margin-top:4px}
input.in:focus,select.in:focus,textarea:focus,button:focus-visible{outline:3px solid var(--sun);outline-offset:1px}
.in.ok{border-color:var(--ok);background:var(--ok-bg);color:var(--ok)}
.in.fixed{border-color:var(--ok);background:var(--ok-bg);color:var(--ok)}
.in.rev{border-color:var(--rev);background:var(--rev-bg);color:var(--rev)}
.in.bad{border-color:var(--bad);background:var(--bad-bg)}
.in[readonly],.in:disabled{opacity:1}
.grp{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
.grp-row{display:flex;gap:10px;flex-wrap:wrap}
.btn{font:inherit;font-weight:700;border-radius:10px;border:2px solid var(--accent);background:var(--accent);color:var(--accent-ink);padding:8px 18px;cursor:pointer}
.btn.ghost{background:transparent;color:var(--accent)}
.btn.warn{border-color:var(--rev);background:transparent;color:var(--rev)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.fb{font-size:15px;min-height:0}
.fb.good{color:var(--ok);font-weight:700}
.fb.try{color:var(--bad)}
.fb ul{margin:4px 0 0;padding-left:1.2em;font-weight:400}
.mcq{display:flex;flex-direction:column;gap:8px}
.mc-q{font-weight:700}
.mc-opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{font:inherit;background:var(--sunk);color:var(--ink);border:2px solid var(--line);border-radius:10px;padding:6px 14px;cursor:pointer;text-align:left}
.opt:hover:not([disabled]){border-color:var(--accent)}
.opt.ok{border-color:var(--ok);background:var(--ok-bg);color:var(--ok);font-weight:700}
.opt.bad{border-color:var(--bad);background:var(--bad-bg);color:var(--bad);text-decoration:line-through}
.opt[disabled]{cursor:default}
.tbl-wrap{overflow-x:auto;max-width:100%}
table{border-collapse:collapse;font-variant-numeric:tabular-nums}
th,td{border:1px solid var(--line);padding:6px 10px;text-align:left;vertical-align:middle}
th{background:var(--sunk);font-size:14px;letter-spacing:.06em;text-transform:uppercase}
td.subj{font-weight:700;white-space:nowrap}
.end{background:var(--sun-soft);color:var(--sun-ink);font-weight:700;border-radius:4px;padding:0 2px}
.prayer{columns:2 300px;column-gap:28px}
.prayer p{break-inside:avoid;margin-bottom:10px}
.vocab{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px}
.voc{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--sunk);border-radius:10px;padding:8px 12px;min-width:0}
.voc .w{font-weight:700}
.voc .en{font-size:14px;color:var(--muted)}
.say{flex:none;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:var(--surface);color:var(--accent);cursor:pointer;display:grid;place-items:center}
.say svg{width:18px;height:18px}
.no-tts .say{display:none}
.facts{display:grid;grid-template-columns:auto 1fr;gap:4px 16px;background:var(--sunk);border-radius:10px;padding:12px 16px}
.facts dt{color:var(--muted);font-size:14px;text-transform:uppercase;letter-spacing:.06em;align-self:center}
.facts dd{margin:0;font-weight:700}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.sent{display:flex;flex-direction:column;gap:12px;margin:0;padding:0;list-style:none}
.sent li{line-height:2.1}
textarea{width:100%;min-height:150px;resize:vertical;line-height:1.6}
.checks{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:6px}
.checks li{display:flex;gap:8px;align-items:center;font-size:15px;color:var(--muted)}
.checks .box{width:20px;height:20px;border-radius:6px;border:2px solid var(--line);flex:none;display:grid;place-items:center;font-size:13px;font-weight:700}
.checks li.yes{color:var(--ok)}
.checks li.yes .box{background:var(--ok);border-color:var(--ok);color:var(--surface)}
.bank{display:flex;flex-wrap:wrap;gap:6px}
.bank span{background:var(--accent-soft);color:var(--accent);border-radius:999px;padding:2px 10px;font-size:15px}
.steps4{counter-reset:s;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.steps4 li{counter-increment:s;background:var(--sunk);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:4px}
.steps4 li::before{content:"Paso " counter(s);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:700}
.machine{display:flex;flex-wrap:wrap;gap:12px;align-items:end}
.machine label{display:flex;flex-direction:column;gap:4px;font-size:14px;color:var(--muted)}
.mout{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}
.mout div{border:1px dashed var(--line);border-radius:10px;padding:10px}
.mout .k{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.mout .v{font-family:var(--display);font-weight:600;font-size:20px}
.mout .final{border-style:solid;border-color:var(--sun);background:var(--sun-soft)}
.mout .final .v{color:var(--sun-ink);font-size:24px}
.form{display:flex;flex-wrap:wrap;gap:14px;align-items:end}
.form label{display:flex;flex-direction:column;gap:4px;font-weight:700;font-size:15px}
.form input,.form select{font:inherit;font-weight:400;padding:8px 10px;border:2px solid var(--line);border-radius:8px;background:var(--sunk);color:var(--ink)}
.summary{border:3px solid var(--accent)}
.sum-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;align-items:baseline}
.sum-name{font-family:var(--display);font-weight:800;font-size:26px}
.sum-meta{color:var(--muted);font-size:15px}
.sum-tbl td,.sum-tbl th{padding:4px 10px;font-size:15px}
.sum-tbl td.num{text-align:right}
.total{font-family:var(--display);font-weight:800;font-size:20px;color:var(--ok)}
.profile-out{background:var(--sunk);border-radius:10px;padding:10px 14px;white-space:pre-wrap;font-size:15px}
nav.bottom{position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.bot-in{max-width:820px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px}
.bot-msg{font-size:14px;color:var(--muted);text-align:center;flex:1;min-width:0}
kbd{font-family:inherit;font-size:14px;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 6px;background:var(--sunk)}
@media (max-width:520px){.qlist>li{grid-template-columns:1.6em 1fr}.card{padding:16px}body{font-size:16px}}
@media (prefers-reduced-motion:no-preference){.step{animation:in .25s ease-out}@keyframes in{from{transform:translateY(6px)}to{transform:none}}}
</style>
</head>
<body>

<header class="top">
  <div class="top-in gut">
    <div class="brand"><span class="brand-k">Español I</span><span class="brand-t">Rotación 8</span></div>
    <div class="who" id="who"></div>
  </div>
  <div class="rail-wrap gut"><div class="rail" id="rail"></div></div>
</header>
<main class="gut" id="main"></main>
<nav class="bottom">
  <div class="bot-in gut">
    <button class="btn ghost" id="back">← Atrás</button>
    <div class="bot-msg" id="botmsg"></div>
    <button class="btn" id="next">Siguiente →</button>
  </div>
</nav>

<script>
(function(){
"use strict";
/* ---------- state ---------- */
var KEY="rot8-espanol1-v1";
var S={name:"",period:"",step:0,max:0,f:{},mc:{},g:{},profile:"",finished:""};
try{var raw=localStorage.getItem(KEY); if(raw){var o=JSON.parse(raw); if(o&&typeof o==="object"){for(var k in o)S[k]=o[k];}}}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}

/* ---------- helpers ---------- */
var DAYS=["domingo","lunes","martes","miércoles","jueves","viernes","sábado"];
var DAYS_ORDER=["lunes","martes","miércoles","jueves","viernes","sábado","domingo"];
var today=new Date(), dIdx=today.getDay();
var AYER=DAYS[(dIdx+6)%7], HOY=DAYS[dIdx], MANANA=DAYS[(dIdx+1)%7];
var PRON=/^(yo|tu|el|ella|usted|nosotros|nosotras|ellos|ellas|ustedes)\s+/;
function norm(s,keepAcc,pro){
  s=String(s||"").toLowerCase().replace(/[¿?¡!.,;:"“”'’()]/g," ").replace(/\s+/g," ").trim();
  if(!keepAcc) s=s.normalize("NFD").replace(/[̀-ͯ]/g,"");
  if(pro) s=s.replace(keepAcc?/^(yo|tú|tu|él|el|ella|usted|nosotros|nosotras|ellos|ellas|ustedes)\s+/:PRON,"");
  return s;
}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];});}
function done(s){return s==="correct"||s==="fixed"||s==="revealed";}
var SPK='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a10 10 0 0 1 0 14"/></svg>';
function say(t){return '<button class="say" type="button" data-say="'+esc(t)+'" aria-label="Escuchar: '+esc(t)+'">'+SPK+'</button>';}
var hasTTS=("speechSynthesis" in window)&&("SpeechSynthesisUtterance" in window);
if(!hasTTS) document.documentElement.classList.add("no-tts");
function speak(t){
  if(!hasTTS) return;
  try{speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(t);u.lang="es-MX";u.rate=.85;
    var vs=speechSynthesis.getVoices()||[];var v=vs.find(function(x){return /^es[-_](MX|US)/i.test(x.lang);})||vs.find(function(x){return /^es/i.test(x.lang);});
    if(v)u.voice=v;speechSynthesis.speak(u);}catch(e){}
}

/* ---------- registries ---------- */
var F={}, MC={}, CUR_G=null;
function G(id){CUR_G=id;return "";}
function f(id,answers,o){o=o||{};F[id]={answers:[].concat(answers),g:CUR_G};for(var k in o)F[id][k]=o[k];return '<span class="fld" data-f="'+id+'"></span>';}
function sel(id,options,answer,o){o=o||{};F[id]={answers:[answer],options:options,type:"select",g:CUR_G};for(var k in o)F[id][k]=o[k];return '<span class="fld" data-f="'+id+'"></span>';}
function grp(id){return '<div class="grp" data-g="'+id+'"></div>';}
function mc(id,q,options,correct,why){MC[id]={q:q,options:options,correct:correct,why:why||""};return '<div class="mcq" data-mc="'+id+'"></div>';}

function chartHTML(gid,cols,subjects,forms){
  G(gid);
  var h='<div class="tbl-wrap"><table><thead><tr><th>Sujeto</th>';
  cols.forEach(function(c){h+='<th>'+c+'</th>';});
  h+='</tr></thead><tbody>';
  subjects.forEach(function(s,i){
    h+='<tr><td class="subj">'+s+'</td>';
    cols.forEach(function(c,j){h+='<td>'+f(gid+"_"+i+"_"+j,forms[j][i],{label:s+" "+c})+'</td>';});
    h+='</tr>';
  });
  return h+'</tbody></table></div>'+grp(gid);
}
function modelChart(verbs){
  var subs=["yo","tú","él / ella / usted","nosotros/as","ellos / ellas / ustedes"];
  var h='<div class="tbl-wrap"><table><thead><tr><th></th>';
  verbs.forEach(function(v){h+='<th>'+v.inf+' <span class="sub" style="text-transform:none;letter-spacing:0">('+v.en+')</span></th>';});
  h+='</tr></thead><tbody>';
  subs.forEach(function(s,i){
    h+='<tr><td class="subj">'+s+'</td>';
    verbs.forEach(function(v){var e=ENDS[v.inf.slice(-2)][i];h+='<td>'+v.inf.slice(0,-2)+'<span class="end">'+e+'</span></td>';});
    h+='</tr>';
  });
  return h+'</tbody></table></div>';
}
var ENDS={ar:["o","as","a","amos","an"],er:["o","es","e","emos","en"],ir:["o","es","e","imos","en"]};
function conj(inf,i){return inf.slice(0,-2)+ENDS[inf.slice(-2)][i];}
function forms(inf){return [0,1,2,3,4].map(function(i){return conj(inf,i);});}

/* ---------- steps ---------- */
var STEPS=[];
function step(o){STEPS.push(o);}

step({id:"inicio",title:"Inicio",min:2,html:function(){return ''+
 '<div class="eyebrow">Lección en línea<span class="time">Español I · Rotación 8</span></div>'+
 '<h1>¡Hola! Today you work on your own.</h1>'+
 '<p class="lead">This lesson reviews <span class="es">tener</span>, practices occupations and profiles, and teaches you how to conjugate regular <b>-ar, -er, -ir</b> verbs. It ends with practice for <b>Quiz 2 on tener</b>, which is next class.</p>'+
 '<div class="card"><h3>How it works</h3><ul class="clean">'+
 '<li>Go through the steps in order. <b>Siguiente</b> unlocks when you finish a step.</li>'+
 '<li>Type your answer and press <b>Revisar</b> or <kbd>Enter</kbd>. Missing accents won\'t count against you, but the page will remind you.</li>'+
 '<li>You get <b>2 tries</b>. After that you can see the answer. Read it carefully before you move on.</li>'+
 '<li>Keep your notebook out and copy anything you want to study.</li>'+
 '<li>At the end you take a <b>screenshot</b> and upload it to Canvas.</li></ul></div>'+
 '<div class="card"><h3>Who are you?</h3><div class="form">'+
 '<label for="nm">Nombre y apellido<input id="nm" autocomplete="off" placeholder="First and last name" value="'+esc(S.name)+'"></label>'+
 '<label for="pd">Período<select id="pd"><option value="">—</option><option'+(S.period==="1"?" selected":"")+'>1</option><option'+(S.period==="5"?" selected":"")+'>5</option><option'+(S.period==="6"?" selected":"")+'>6</option></select></label>'+
 '</div><p class="sub">Use your real name. Your teacher will see it on your screenshot.</p></div>';},
 after:function(root){
   var nm=root.querySelector("#nm"), pd=root.querySelector("#pd");
   nm.addEventListener("input",function(){S.name=nm.value.trim();save();refresh();});
   pd.addEventListener("change",function(){S.period=pd.value;save();refresh();});
 },
 ready:function(){return S.name.length>=2&&!!S.period;},
 why:"Escribe tu nombre y elige tu período."
});

step({id:"oracion",title:"Oración y fecha",min:5,html:function(){return ''+
 '<h2>La oración y la fecha</h2>'+
 '<p class="lead">Pray together as a class first. Then answer the date questions on your own.</p>'+
 '<div class="card"><h3>Intenciones especiales</h3><p>Think of someone you want to pray for. <span class="es">Por mi familia · Por mis amigas · Por los enfermos · Por mi abuela…</span></p>'+
 '<div class="prayer"><p><b>La Señal de la Cruz</b><br><span class="es">En el nombre del Padre, y del Hijo, y del Espíritu Santo. Amén.</span></p>'+
 '<p><b>El Padre Nuestro</b><br><span class="es">Padre nuestro, que estás en el cielo, santificado sea tu Nombre; venga a nosotros tu reino; hágase tu voluntad en la tierra como en el cielo. Danos hoy nuestro pan de cada día; perdona nuestras ofensas, como también nosotros perdonamos a los que nos ofenden; no nos dejes caer en la tentación, y líbranos del mal. Amén.</span></p></div></div>'+
 G("fecha")+
 '<div class="card"><h3>La fecha</h3><ul class="sent">'+
 '<li><b>Ayer fue</b> '+sel("ayer",DAYS_ORDER,AYER,{label:"Ayer fue"})+'. <span class="sub">(Yesterday was)</span></li>'+
 '<li><b>Hoy es</b> '+sel("hoy",DAYS_ORDER,HOY,{label:"Hoy es"})+'. <span class="sub">(Today is)</span></li>'+
