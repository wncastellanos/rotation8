step({id:"verbos",title:"Verbos nuevos",min:8,html:function(){return ''+
 '<h2>Verbos nuevos: -ar, -er, -ir</h2><p class="lead">Most Spanish verbs follow a pattern. Once you learn the pattern, you can conjugate hundreds of verbs. Go slowly here. This is new.</p>'+
 '<div class="card"><h3>The infinitive</h3><p>The <b>infinitive</b> is the basic form of a verb. In English it starts with “to.” In Spanish it ends in <b>-ar</b>, <b>-er</b> or <b>-ir</b>.</p>'+
 '<p><span class="es">habl<span class="end">ar</span></span> = to speak · <span class="es">com<span class="end">er</span></span> = to eat · <span class="es">viv<span class="end">ir</span></span> = to live</p>'+
 '<p>To <b>conjugate</b> means to change the verb so it matches who is doing the action.</p></div>'+
 '<div class="card"><h3>4 steps to conjugate</h3><ol class="steps4"><li><b>Find the subject.</b> Who is doing it? <span class="es">yo</span></li><li><b>Find the ending.</b> Is it -ar, -er or -ir? <span class="es">hablar → -ar</span></li><li><b>Drop the ending.</b> Keep the stem. <span class="es">habl-</span></li><li><b>Add the new ending.</b> Use the chart. <span class="es">habl + o = hablo</span></li></ol>'+
 '<div class="tbl-wrap"><table><thead><tr><th></th><th>-AR</th><th>-ER</th><th>-IR</th></tr></thead><tbody>'+
 MSUBJ.map(function(s,i){return '<tr><td class="subj">'+s+'</td><td><span class="end">-'+ENDS.ar[i]+'</span></td><td><span class="end">-'+ENDS.er[i]+'</span></td><td><span class="end">-'+ENDS.ir[i]+'</span></td></tr>';}).join("")+
 '</tbody></table></div><p class="sub">Notice: -er and -ir are the same except for nosotros (-emos / -imos). Copy this chart into your notebook.</p></div>'+
 '<div class="card"><h3>La máquina de verbos</h3><p>Pick a verb and a subject and watch the 4 steps happen.</p>'+
 '<div class="machine"><label for="mv">Verbo<select id="mv" class="in">'+MVERBS.map(function(v){return '<option value="'+v[0]+'">'+v[0]+' ('+v[1]+')</option>';}).join("")+'</select></label>'+
 '<label for="ms">Sujeto<select id="ms" class="in">'+MSUBJ.map(function(s,i){return '<option value="'+i+'">'+s+'</option>';}).join("")+'</select></label></div>'+
 '<div class="mout" id="mout"></div></div>'+
 '<div class="card"><h3>Ejemplos</h3>'+modelChart([{inf:"practicar",en:"to practice"},{inf:"leer",en:"to read"},{inf:"escribir",en:"to write"}])+
 '<div class="rule"><p><strong>Key point:</strong> after <span class="es">tener que</span>, the second verb does <b>not</b> change. It stays in the infinitive.</p><p><span class="es">Leo un libro.</span> (I read a book.) · <span class="es">Tengo que leer un libro.</span> (I have to read a book.)</p></div></div>'+
 '<div class="card"><h3>Check yourself</h3>'+
 mc("v1","Yo + comer = ?",["come","comer","como","comemos"],2,"Drop -er → com-, add -o → como.")+
 mc("v2","Ellas + escribir = ?",["escribimos","escriben","escribe","escribir"],1,"Ellas uses -en for -ir verbs → escriben.")+
 mc("v3","Nosotros + estudiar: what do you drop first?",["-ar","estud-","nosotros"],0,"Drop the -ar, keep estudi-, then add -amos → estudiamos.")+
 '</div>';},
 after:function(root){
   var mv=root.querySelector("#mv"),ms=root.querySelector("#ms"),out=root.querySelector("#mout");
   function upd(){var v=mv.value,i=+ms.value,end=v.slice(-2),stem=v.slice(0,-2);
     out.innerHTML='<div><div class="k">1 · Sujeto</div><div class="v">'+MSUBJ[i]+'</div></div><div><div class="k">2 · Terminación</div><div class="v">-'+end+'</div></div><div><div class="k">3 · Raíz</div><div class="v">'+stem+'-</div></div><div class="final"><div class="k">4 · Nueva forma</div><div class="v">'+stem+'<span class="end">'+ENDS[end][i]+'</span></div></div>';}
