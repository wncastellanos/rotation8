  root.querySelectorAll(".fld").forEach(function(el){
    var id=el.dataset.f,d=F[id],inp;
    if(d.type==="select"){inp=document.createElement("select");inp.innerHTML='<option value="">—</option>'+d.options.map(function(o){return '<option>'+o+'</option>';}).join("");}
    else{inp=document.createElement("input");inp.type="text";inp.autocomplete="off";inp.spellcheck=false;inp.setAttribute("autocapitalize","off");
      var L=Math.max.apply(null,d.answers.map(function(a){return a.length;}));inp.style.width=Math.max(6,L+3)+"ch";if(d.wide)inp.classList.add("wide");}
    inp.id="f-"+id;inp.classList.add("in");inp.setAttribute("aria-label",d.label||"respuesta");
    var st=S.f[id];if(st&&st.v)inp.value=st.v;
    inp.addEventListener(d.type==="select"?"change":"input",function(){ensure(id).v=inp.value;inp.classList.remove("bad");save();});
    if(d.type!=="select")inp.addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();checkGroup(d.g);}});
    el.replaceWith(inp);d.el=inp;applyField(id);
  });
  root.querySelectorAll(".grp").forEach(function(el){
    var gid=el.dataset.g;
    el.innerHTML='<div class="grp-row"><button class="btn" type="button" data-act="check">Revisar</button><button class="btn warn" type="button" data-act="reveal" hidden>Ver respuestas</button></div><div class="fb" aria-live="polite"></div>';
    el.querySelector('[data-act="check"]').addEventListener("click",function(){checkGroup(gid);});
    el.querySelector('[data-act="reveal"]').addEventListener("click",function(){revealGroup(gid);});
    groupFeedback(gid,null);
  });
  root.querySelectorAll(".mcq").forEach(function(el){renderMC(el,el.dataset.mc);});
}
function applyField(id){
  var d=F[id],el=d.el,st=S.f[id];if(!el)return;
  el.classList.remove("ok","fixed","rev","bad");
  if(!st)return;
  if(st.s==="correct")el.classList.add("ok");else if(st.s==="fixed")el.classList.add("fixed");else if(st.s==="revealed")el.classList.add("rev");else if(st.t>0)el.classList.add("bad");
  if(done(st.s)){if(d.type==="select")el.disabled=true;else el.readOnly=true;}
}
function evalField(id){
  var d=F[id],v=d.el.value;
  if(d.type==="select")return {ok:v===d.answers[0]};
  if(d.validate)return {ok:d.validate(v)};
  var a=norm(v,true,d.pro),b=norm(v,false,d.pro),i;
  for(i=0;i<d.answers.length;i++)if(norm(d.answers[i],true,d.pro)===a)return {ok:true};
  for(i=0;i<d.answers.length;i++)if(norm(d.answers[i],false,d.pro)===b)return {ok:true,note:d.answers[i]};
  return {ok:false};
}
function groupIds(gid){return Object.keys(F).filter(function(k){return F[k].g===gid;});}
function checkGroup(gid){
  var ids=groupIds(gid),pending=ids.filter(function(k){return !done((S.f[k]||{}).s);});
  if(!pending.length)return;
  var empty=pending.filter(function(k){return !F[k].el.value.trim();});
  if(empty.length){groupFeedback(gid,{empty:true});F[empty[0]].el.focus();return;}
  var hints=[],notes=[];
  pending.forEach(function(k){var r=evalField(k),st=ensure(k);st.v=F[k].el.value;st.t=(st.t||0)+1;
    if(r.ok){st.s=st.t===1?"correct":"fixed";if(r.note)notes.push(r.note);}else{if(F[k].hint)hints.push(F[k].hint);}
    applyField(k);});
  S.g[gid]=(S.g[gid]||0)+1;save();groupFeedback(gid,{hints:hints,notes:notes});refresh();
}
function revealGroup(gid){
  groupIds(gid).forEach(function(k){var st=ensure(k);if(!done(st.s)){st.s="revealed";st.v=F[k].answers[0];F[k].el.value=F[k].answers[0];applyField(k);}});
  save();groupFeedback(gid,{revealed:true});refresh();
}
function groupFeedback(gid,info){
  var el=document.querySelector('.grp[data-g="'+gid+'"]');if(!el)return;
  var fb=el.querySelector(".fb"),rv=el.querySelector('[data-act="reveal"]'),ck=el.querySelector('[data-act="check"]');
  var ids=groupIds(gid),left=ids.filter(function(k){return !done((S.f[k]||{}).s);}).length,tries=S.g[gid]||0;
  var anyRev=ids.some(function(k){return (S.f[k]||{}).s==="revealed";});
  fb.className="fb";rv.hidden=true;ck.disabled=false;
  if(!left){ck.disabled=true;
    if(anyRev){fb.innerHTML="The answers in yellow are the correct ones. Read them and copy any you missed into your notebook.";}
    else{fb.className="fb good";var h="¡Muy bien! Todo correcto.";
      if(info&&info.notes&&info.notes.length)h+='<ul><li>Watch the accents: '+info.notes.map(esc).join(" · ")+'</li></ul>';fb.innerHTML=h;}
    return;}
  if(info&&info.empty){fb.className="fb try";fb.textContent="Fill in every blank first, then press Revisar.";}
  else if(tries>0){fb.className="fb try";
    var h2="Todavía no. Fix the "+(left===1?"answer":left+" answers")+" in red and try again.";
    var hs=(info&&info.hints)||[];hs=hs.filter(function(x,i){return hs.indexOf(x)===i;});
    if(hs.length)h2+='<ul>'+hs.map(function(x){return '<li>Pista: '+esc(x)+'</li>';}).join("")+'</ul>';
    fb.innerHTML=h2;}
  if(tries>=2)rv.hidden=false;
}
function renderMC(el,id){
  var d=MC[id],st=S.mc[id]||{s:"",t:0,wrong:[]};
  el.innerHTML='<p class="mc-q">'+d.q+'</p><div class="mc-opts" role="group">'+d.options.map(function(o,i){return '<button type="button" class="opt" data-i="'+i+'">'+esc(o)+'</button>';}).join("")+'</div><p class="fb" aria-live="polite"></p>';
  var btns=el.querySelectorAll(".opt"),fb=el.querySelector(".fb");
  function paint(){
    btns.forEach(function(b,i){b.classList.toggle("bad",st.wrong.indexOf(i)>-1);if(st.wrong.indexOf(i)>-1)b.disabled=true;
      if(done(st.s)){b.disabled=true;if(i===d.correct)b.classList.add("ok");}});
    if(done(st.s)){fb.className="fb good";fb.textContent=(st.s==="correct"?"¡Correcto! ":"Ahora sí. ")+d.why;}
    else if(st.t>0){fb.className="fb try";fb.textContent="Todavía no. Try another answer.";}
  }
  btns.forEach(function(b){b.addEventListener("click",function(){
    var i=+b.dataset.i;st.t++;
    if(i===d.correct)st.s=st.t===1?"correct":"fixed";else st.wrong.push(i);
    S.mc[id]=st;save();paint();refresh();});});
  paint();
}

/* ---------- step status ---------- */
function stepItems(i){var sec=SECTIONS[i];
  var fs=[].map.call(sec.querySelectorAll(".in[id^='f-']"),function(e){return e.id.slice(2);});
  var ms=[].map.call(sec.querySelectorAll(".mcq"),function(e){return e.dataset.mc;});
  return {fs:fs,ms:ms};}
function stepReady(i){
  var s=STEPS[i];if(s.ready&&!s.ready())return false;
  var it=stepItems(i);
  return it.fs.every(function(k){return done((S.f[k]||{}).s);})&&it.ms.every(function(k){return done((S.mc[k]||{}).s);});
}
function stepScore(i){
  var it=stepItems(i),r={c:0,x:0,v:0,n:0};
  it.fs.forEach(function(k){var s=(S.f[k]||{}).s;r.n++;if(s==="correct")r.c++;else if(s==="fixed")r.x++;else if(s==="revealed")r.v++;});
  it.ms.forEach(function(k){var s=(S.mc[k]||{}).s;r.n++;if(s==="correct")r.c++;else if(s==="fixed")r.x++;});
  return r;
}

/* ---------- navigation ---------- */
var rail=document.getElementById("rail"),back=document.getElementById("back"),next=document.getElementById("next"),botmsg=document.getElementById("botmsg"),who=document.getElementById("who");
function go(i){
  if(i<0||i>=STEPS.length||i>S.max)return;
  S.step=i;save();
  SECTIONS.forEach(function(sec,j){sec.hidden=j!==i;});
  if(STEPS[i].id==="final"){if(!S.finished){S.finished=new Date().toISOString();save();}STEPS[i].after(SECTIONS[i]);}
  window.scrollTo(0,0);refresh();
  var c=rail.querySelector('.chip[data-i="'+i+'"]');if(c&&c.scrollIntoView)c.scrollIntoView({block:"nearest",inline:"center"});
}
function refresh(){
  var i=S.step,ready=stepReady(i);
  if(ready&&S.max===i&&i<STEPS.length-1){/* unlock next */}
  rail.innerHTML=STEPS.map(function(s,j){var cls="chip"+(j===i?" cur":(stepReady(j)&&j<=S.max&&j!==STEPS.length-1?" done":""));
    return '<button type="button" class="'+cls+'" data-i="'+j+'"'+(j>S.max?" disabled":"")+'><span class="n">'+(j===0?"★":j===STEPS.length-1?"✓":j)+'</span>'+s.title+'</button>';}).join("");
  back.disabled=i===0;
  var last=i===STEPS.length-1;
  next.hidden=last;next.disabled=!ready;
  next.textContent=i===STEPS.length-2?"Terminar →":(i===0?"Empezar →":"Siguiente →");
  botmsg.textContent=last?"Take your screenshot now.":(ready?"":(STEPS[i].why||"Finish every question to continue."));
  who.innerHTML=S.name?('<b>'+esc(S.name)+'</b>'+(S.period?' · Período '+esc(S.period):'')):"";
}
rail.addEventListener("click",function(e){var b=e.target.closest(".chip");if(b&&!b.disabled)go(+b.dataset.i);});
back.addEventListener("click",function(){go(S.step-1);});
next.addEventListener("click",function(){if(!stepReady(S.step))return;if(S.max<S.step+1)S.max=S.step+1;go(S.step+1);});
document.addEventListener("click",function(e){var b=e.target.closest(".say");if(b)speak(b.dataset.say);});

/* ---------- final ---------- */
function renderFinal(box){
  var rows="",tot={c:0,x:0,v:0,n:0};
  for(var i=1;i<STEPS.length-1;i++){var r=stepScore(i);if(STEPS[i].id==="tuperfil")continue;
    tot.c+=r.c;tot.x+=r.x;tot.v+=r.v;tot.n+=r.n;
    rows+='<tr><td>'+i+'. '+STEPS[i].title+'</td><td class="num">'+r.c+'</td><td class="num">'+r.x+'</td><td class="num">'+r.v+'</td><td class="num">'+r.n+'</td></tr>';}
  var fin=S.finished?new Date(S.finished):new Date();
  var when=fin.toLocaleDateString("es-US",{weekday:"long",day:"numeric",month:"long"})+" · "+fin.toLocaleTimeString("es-US",{hour:"numeric",minute:"2-digit"});
  var pct=tot.n?Math.round((tot.c+tot.x)/tot.n*100):0;
  box.innerHTML='<h2>¡Terminaste! Take your screenshot.</h2>'+
  '<p class="lead">Take a screenshot of the box below and upload it to Canvas under <b>“Rotación 8: Lección en línea.”</b></p>'+
  '<div class="card summary"><div class="sum-head"><div class="sum-name">'+esc(S.name||"(sin nombre)")+'</div><div class="sum-meta">Período '+esc(S.period||"?")+' · '+when+'</div></div>'+
  '<div class="tbl-wrap"><table class="sum-tbl"><thead><tr><th>Paso</th><th>1st try</th><th>Fixed</th><th>Shown</th><th>Total</th></tr></thead><tbody>'+rows+
  '<tr><td><b>Total</b></td><td class="num"><b>'+tot.c+'</b></td><td class="num"><b>'+tot.x+'</b></td><td class="num"><b>'+tot.v+'</b></td><td class="num"><b>'+tot.n+'</b></td></tr></tbody></table></div>'+
  '<div class="total">'+pct+'% answered correctly on my own</div>'+
  '<div><b>Mi perfil</b><div class="profile-out es">'+esc(S.profile||"")+'</div></div></div>'+
  '<div class="two"><div class="card"><h3>How to take a screenshot</h3><ul class="clean"><li><b>Chromebook:</b> <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>Show windows</kbd>, then drag over the box</li><li><b>Windows:</b> <kbd>Windows</kbd> + <kbd>Shift</kbd> + <kbd>S</kbd></li><li><b>Mac:</b> <kbd>Cmd</kbd> + <kbd>Shift</kbd> + <kbd>4</kbd></li></ul></div>'+
  '<div class="card"><h3>Before you leave</h3><ul class="clean"><li>Get the worksheet <b>“¿Quién eres? ¿Qué tienes que hacer?”</b> from your teacher.</li><li><b>Tarea:</b> finish all 3 pages and <b>upload a photo of the completed worksheet to Canvas</b>.</li><li><b>Study for Quiz 2 on tener.</b> It is next class. Study resources are on Canvas.</li></ul></div></div>';
}

/* ---------- start ---------- */
if(S.step>S.max)S.max=S.step;
go(Math.min(S.step||0,STEPS.length-1));
})();
</script>
